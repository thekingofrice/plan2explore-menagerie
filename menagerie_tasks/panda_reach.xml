<!--
  panda_reach.xml

  Implements: References/SelfEx-WM_Notes.tex §8 Phase 2: First Menagerie Task - Panda Reach.
  Frozen constants live in ENVIRONMENT_SPEC.md; this file must agree with them.

  This is OUR task scene. It <include>s the Menagerie Panda unmodified and adds only what the
  reaching task needs:

    * target_site  - the goal marker g (§8.1). VISUAL ONLY: no mass, no contact, no collision
                     geometry. Its position is written by the env at reset via model.site_pos.
                     Nothing in the physics depends on it.
    * track_cam    - a fixed camera for rgb_array rendering (§10 "Render test").

  NOT defined here: p_ee. Menagerie's Panda declares no sites (nsite == 0), and MJCF cannot reopen
  a body that came from an <include>, so an ee_site cannot be attached to the `hand` body from this
  file. The environment instead computes p_ee directly from the hand body's pose:

      p_ee = data.xpos[hand] + data.xmat[hand] @ (0, 0, 0.1034)

  where 0.1034 m is the Franka TCP offset along the hand frame's +z, between the fingers. This is
  exact, needs no model surgery, and keeps the Menagerie checkout untouched (§3).

  Include depth: ONE level, deliberately. Menagerie's scene.xml contains a bare
  <include file="panda.xml"/>, and MuJoCo compounds the base directory across nested cross-directory
  includes -- including scene.xml from here makes it look for
  franka_emika_panda/third_party/mujoco_menagerie/franka_emika_panda/panda.xml and fail. So we
  include panda.xml directly and declare scene.xml's floor/light/skybox ourselves below. They are
  part of our task scene regardless.
-->
<mujoco model="panda_reach">

  <include file="../third_party/mujoco_menagerie/franka_emika_panda/panda.xml"/>

  <!-- Equivalent of Menagerie scene.xml's visual/asset blocks, declared here to keep one include. -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <!--
    §8.4 Control interval. Menagerie's panda.xml sets timestep 0.002 s; combined with
    dt_control = 0.05 s this gives exactly n_substeps = 25. Restated here so the assumption is
    visible in the task file -- the env additionally asserts the substep count is integral at
    construction, so an upstream bump fails loudly instead of silently changing the control rate.
  -->
  <option timestep="0.002"/>

  <worldbody>
    <!-- From Menagerie scene.xml; see the include note above. -->
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!--
      §8.1 target g. contype/conaffinity 0 keep it out of collision entirely; group 2 separates it
      from the robot's visual geoms. The position here is a placeholder, overwritten every reset.
    -->
    <site name="target_site"
          pos="0.45 0.0 0.40"
          size="0.02"
          type="sphere"
          rgba="1 0 0 0.6"
          group="2"
          contype="0"
          conaffinity="0"/>

    <!-- §10 "Render test": a fixed viewpoint so frames are comparable across runs and seeds. -->
    <camera name="track_cam"
            pos="1.4 -1.0 1.0"
            xyaxes="0.6 0.8 0 -0.35 0.26 0.9"/>
  </worldbody>

</mujoco>
